# Chiave API Anthropic — resta SOLO sul server
ANTHROPIC_API_KEY=sk-ant-api03-...

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role (Settings → API → service_role) — usata SOLO dai cron job.
# NON esporla mai con prefisso NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Segreto per autenticare i cron Vercel (stringa casuale lunga).
# Su Vercel: Settings → Environment Variables → CRON_SECRET (Vercel la manda
# automaticamente nell'header Authorization dei cron).
CRON_SECRET=

# OPZIONALE — Twelve Data (twelvedata.com → free tier 800 req/giorno).
# Migliora molto l'affidabilità di grafici e performance (ETF europei inclusi).
# Senza chiave si usa Yahoo Finance come ripiego.
TWELVEDATA_API_KEY=

# OPZIONALE — FRED (fred.stlouisfed.org/docs/api/api_key.html → gratuita).
# Dati macro USA ufficiali: serie nei grafici + snapshot macro nei prompt AI.
# Senza chiave i grafici macro ricadono sui ticker e lo snapshot è omesso.
FRED_API_KEY=
